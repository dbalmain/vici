case viewport-half-page
text 0\n1\n2\n3\n4\n5\n6\n7
keys j<C-d>
with viewport=0,6
---
case viewport-full-page
text 0\n1\n2\n3\n4\n5\n6\n7
keys j<C-f>
with viewport=0,6
---
case viewport-clamps-ends
text 0\n1\n2
keys <C-u><C-b>G<C-d><C-f>
with viewport=0,6
---
case viewport-dollar-sticky
text xx\nlong second\nlong third\nx
keys $<C-d>
with viewport=0,4
---
case viewport-screen-motions
text zero\n one\n two\n three\n four\n five\n six\nseven
keys H2HM3ML2L
with viewport=2,5
---
case viewport-screen-operator-top
text 0\n1\n2\n3\n4\n5
keys GdH
with viewport=2,3
---
case viewport-screen-operator-bottom
text 0\n1\n2\n3\n4\n5
keys dL
with viewport=2,3
---
case viewport-zero-height-scroll
text 0\n1\n2
keys j<C-d><C-u><C-f><C-b>
---
case screen-motion-without-viewport
text zero\none
keys HML
