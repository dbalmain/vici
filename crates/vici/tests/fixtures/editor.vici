# Regenerate deliberately with: INSTA_UPDATE=always cargo test -p vici --test editor_cases
# Movement
case move-right-count
text select id, name\nfrom users\nwhere id = 1
keys 3l
---
case move-down
text select id, name\nfrom users\nwhere id = 1
keys jj
---
case move-dollar-and-home
text select id, name\nfrom users\nwhere id = 1
keys $0
---
case move-goto-last-and-first
text select id, name\nfrom users\nwhere id = 1
keys Ggg
---
case move-goto-counted-row
