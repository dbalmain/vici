{
  "name": "vici.js",
  "version": "0.1.0",
  "description": "A headless vi editing core: modes, motions, operators, counts, text objects, visual mode, undo, dot-repeat and macros, with no view attached.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbalmain/vici.git",
    "directory": "js"
  },
  "homepage": "https://github.com/dbalmain/vici/tree/main/js#readme",
  "bugs": "https://github.com/dbalmain/vici/issues",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "keywords": [
    "vi",
    "vim",
    "editor",
    "keybindings",
    "modal",
    "headless"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "bench": "node bench/run.js",
    "size": "node bench/size.js",
    "types": "tsc -p jsconfig.json",
    "check": "tsc -p jsconfig.json --noEmit",
    "fuzz": "node test/fuzz.js",
    "prepack": "npm run check && npm run types"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
